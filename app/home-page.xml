<?xml version="1.0" encoding="UTF-8"?>
<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="onNavigatingTo" class="page">
  <ScrollView>
    <StackLayout class="p-16">
      <Label text="Inventory Scanner" class="h1 text-center mb-16" />

      <StackLayout class="card">
        <Label text="1) Recording Profile" class="h2 mb-8" />
        <StackLayout orientation="horizontal" class="mb-8">
          <Button text="Scan QR" tap="onScanQr" class="btn btn-primary mr-8" />
          <Button text="Reset" tap="onResetScan" class="btn btn-secondary" />
        </StackLayout>
        <GridLayout columns="auto, *" rows="auto, auto" class="mb-8">
          <Label text="API Endpoint:" row="0" col="0" />
          <Label id="statusApi" text="missing" class="pill pill-gray" row="0" col="1" />
          <Label text="Recording Info:" row="1" col="0" />
          <Label id="statusInfo" text="missing" class="pill pill-gray" row="1" col="1" />
        </GridLayout>
        <Label text="Paste JSON instead" class="h3 mt-8" />
        <TextView id="pasteJson" hint="Paste QR JSON here" class="textarea" />
        <Button text="Detect" tap="onDetectPaste" class="btn btn-secondary mt-8" />
        <Label text="Advanced: Optional Bearer Token" class="h3 mt-8" />
        <TextField id="bearerToken" secure="true" hint="Bearer token (optional)" />
        <StackLayout orientation="horizontal" class="mt-12">
          <Button id="btnSaveProfile" text="Save Profile" tap="onSaveProfile" class="btn btn-primary mr-8" />
          <Button text="Clear Profile" tap="onClearProfile" class="btn btn-danger" />
        </StackLayout>
        <Label text="Current Profile" class="h3 mt-12" />
        <TextView id="profileSummary" editable="false" class="textarea" />
      </StackLayout>

      <StackLayout class="card mt-12">
        <Label text="2) Work" class="h2 mb-8" />
        <Label text="Package No" class="label" />
        <StackLayout orientation="horizontal">
          <TextField id="packageNo" hint="Scan or type package number" class="flex-1" />
          <Button text="Scan Barcode" tap="onScanBarcode" class="btn ml-8" />
        </StackLayout>
        <StackLayout orientation="horizontal" class="mt-8">
          <Label text="Package intact" />
          <Switch id="packageIntact" checked="true" checkedChange="onPackageIntactChanged" />
        </StackLayout>
        <Label text="Quantity" class="mt-8" />
        <StackLayout orientation="horizontal">
          <Button text="−" tap="onQtyMinus" class="btn btn-icon" />
          <TextField id="quantity" keyboardType="number" text="0" />
          <Button text="+" tap="onQtyPlus" class="btn btn-icon" />
        </StackLayout>
        <Label text="Disabled when Package intact is checked." class="hint mt-4" />
        <Button text="Submit" tap="onSubmit" class="btn btn-primary mt-12" />
        <TextView id="result" editable="false" class="textarea mt-12" />
      </StackLayout>
    </StackLayout>
  </ScrollView>
</Page>
