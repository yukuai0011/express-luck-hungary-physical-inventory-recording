{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Express Luck Inventory",
  "version": "0.1.0",
  "identifier": "com.expressluck.inventory",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../.output/public",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "title": "Express Luck Inventory",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
