{
  "name": "inventory-scanner",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:android": "eas build --platform android --profile production",
    "build:windows": "electron-builder --windows",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm run web\" \"wait-on http://localhost:8081 && electron .\"",
    "test": "jest",
    "lint": "eslint ."
  },
  "dependencies": {
    "expo": "~51.0.0",
    "expo-camera": "~15.0.0",
    "expo-barcode-scanner": "~13.0.0",
    "expo-secure-store": "~13.0.0",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-web": "~0.19.10",
    "nativewind": "^2.0.11",
    "tailwindcss": "^3.3.0",
    "react-native-qrcode-scanner": "^1.5.5",
    "expo-status-bar": "~1.12.1",
    "uuid": "^9.0.1",
    "@react-native-async-storage/async-storage": "1.23.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.2.79",
    "@types/react-native": "~0.73.0",
    "@types/uuid": "^9.0.7",
    "typescript": "^5.3.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0"
  },
  "private": true,
  "build": {
    "appId": "com.expressluck.inventoryscanner",
    "productName": "Inventory Scanner",
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "files": [
      "dist/**/*",
      "electron.js",
      "package.json"
    ]
  }
}
